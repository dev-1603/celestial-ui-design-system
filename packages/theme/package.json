{
  "name": "@celestial-ui/theme",
  "version": "0.1.0",
  "description": "Theme identity, modes, inheritance, tenant profiles, and resolution for the Celestial UI ecosystem.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./themes/celestial": {
      "types": "./dist/themes/celestial.d.ts",
      "default": "./dist/themes/celestial.js"
    },
    "./mode": {
      "types": "./dist/mode.d.ts",
      "default": "./dist/mode.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "default": "./dist/resolve.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "default": "./dist/slots.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    }
  },
  "typesVersions": {
    "*": {
      "themes/celestial": [
        "./dist/themes/celestial.d.ts"
      ],
      "mode": [
        "./dist/mode.d.ts"
      ],
      "registry": [
        "./dist/registry.d.ts"
      ],
      "resolve": [
        "./dist/resolve.d.ts"
      ],
      "slots": [
        "./dist/slots.d.ts"
      ],
      "validate": [
        "./dist/validate.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "design-system",
    "theme",
    "celestial"
  ],
  "author": "Celestial Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@celestial-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  }
}
