{
  "name": "@celestial-ui/theme",
  "version": "0.1.0",
  "description": "Theme identity, modes, inheritance, tenant profiles, and resolution for the Celestial UI ecosystem.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./themes/celestial": {
      "import": {
        "types": "./dist/esm/themes/celestial.d.ts",
        "default": "./dist/esm/themes/celestial.js"
      },
      "require": {
        "types": "./dist/cjs/themes/celestial.d.ts",
        "default": "./dist/cjs/themes/celestial.js"
      },
      "default": "./dist/cjs/themes/celestial.js"
    },
    "./mode": {
      "import": {
        "types": "./dist/esm/mode.d.ts",
        "default": "./dist/esm/mode.js"
      },
      "require": {
        "types": "./dist/cjs/mode.d.ts",
        "default": "./dist/cjs/mode.js"
      },
      "default": "./dist/cjs/mode.js"
    },
    "./registry": {
      "import": {
        "types": "./dist/esm/registry.d.ts",
        "default": "./dist/esm/registry.js"
      },
      "require": {
        "types": "./dist/cjs/registry.d.ts",
        "default": "./dist/cjs/registry.js"
      },
      "default": "./dist/cjs/registry.js"
    },
    "./resolve": {
      "import": {
        "types": "./dist/esm/resolve.d.ts",
        "default": "./dist/esm/resolve.js"
      },
      "require": {
        "types": "./dist/cjs/resolve.d.ts",
        "default": "./dist/cjs/resolve.js"
      },
      "default": "./dist/cjs/resolve.js"
    },
    "./slots": {
      "import": {
        "types": "./dist/esm/slots.d.ts",
        "default": "./dist/esm/slots.js"
      },
      "require": {
        "types": "./dist/cjs/slots.d.ts",
        "default": "./dist/cjs/slots.js"
      },
      "default": "./dist/cjs/slots.js"
    },
    "./validate": {
      "import": {
        "types": "./dist/esm/validate.d.ts",
        "default": "./dist/esm/validate.js"
      },
      "require": {
        "types": "./dist/cjs/validate.d.ts",
        "default": "./dist/cjs/validate.js"
      },
      "default": "./dist/cjs/validate.js"
    }
  },
  "typesVersions": {
    "*": {
      "themes/celestial": [
        "./dist/cjs/themes/celestial.d.ts"
      ],
      "mode": [
        "./dist/cjs/mode.d.ts"
      ],
      "registry": [
        "./dist/cjs/registry.d.ts"
      ],
      "resolve": [
        "./dist/cjs/resolve.d.ts"
      ],
      "slots": [
        "./dist/cjs/slots.d.ts"
      ],
      "validate": [
        "./dist/cjs/validate.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && tsc -p tsconfig.esm.json && node ../../tooling/write-dual-package-json.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.esm.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.esm.json",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "design-system",
    "theme",
    "celestial"
  ],
  "author": "Celestial Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-1603/celestial-ui-design-system.git",
    "directory": "packages/theme"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@celestial-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  }
}
