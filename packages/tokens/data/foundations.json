          "layer": "foundation"
        }
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "0.375rem",
      "$extensions": {
        "celestial": {
          "layer": "foundation"
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "0.5rem",
      "$extensions": {
        "celestial": {
          "layer": "foundation"
        }
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": "0.75rem",
      "$extensions": {
