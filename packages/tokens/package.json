{
  "name": "@celestial-ui/tokens",
  "version": "0.1.0",
  "description": "Framework-agnostic, canonical design-token package for the Celestial Nexus ecosystem.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/tokens.css",
    "./tailwind": "./dist/tailwind.preset.js",
    "./shadcn": "./dist/css/shadcn-mapping.css",
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "default": "./dist/resolve.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "default": "./dist/a11y.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./generators": {
      "types": "./dist/generators.d.ts",
      "default": "./dist/generators.js"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types.d.ts"
      ],
      "resolve": [
        "./dist/resolve.d.ts"
      ],
      "catalog": [
        "./dist/catalog.d.ts"
      ],
      "a11y": [
        "./dist/a11y.d.ts"
      ],
      "validation": [
        "./dist/validation.d.ts"
      ],
      "generators": [
        "./dist/generators.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node ./dist/scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "!dist/scripts",
    "!dist/scripts/**",
    "data"
  ],
  "keywords": [
    "design-tokens",
    "celestial",
    "theme"
  ],
  "author": "Celestial Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  }
}
